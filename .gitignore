node_modules/
dist/
build/*.png
*.log
.env

# Webhook token must never be committed; launcher seeds it at deploy time.
config/voidfps-feedback.url
config/*.url
# Ad-hoc diagnostics stay out; verify_launcher.js is the tracked suite and is added with -f.
# (Ignoring the whole verify_* pattern silently kept the 68-assertion suite out of the repo.)
diag_*.js
verify_*.js

# Public download site is source, not build output: dist/ is wiped by
# electron-builder, so the pages must live in a committed directory.
work-ui/
dist-linux/
dist-web/
