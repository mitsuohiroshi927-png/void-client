{
  "name": "void-client",
  "productName": "VOID Client",
  "desktopName": "void-client.desktop",
  "version": "1.3.7",
  "description": "VOID Client - Minecraft Java Edition launcher",
  "author": "VOID Client",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "start:xvfb": "xvfb-run -a electron . --no-sandbox",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "id.agung.voidclient",
    "productName": "VOID Client",
    "copyright": "Copyright (c) 2026 VOID Client",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VOID-Client-${version}-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "VOID-Client-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "synopsis": "Minecraft Java launcher with VOID Client built in",
      "description": "Runs every Minecraft 1.21.x version with Fabric already installed. Mods install from Modrinth inside the app, and the VOID Client performance mod ships bundled."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VOID Client",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*.jar"
        ]
      }
    ],
    "nsisWeb": {
      "appPackageUrl": "https://github.com/mitsuohiroshi927-png/void-client/releases/download/v1.2.7",
      "artifactName": "VOID-Client-${version}-Web-Setup.${ext}"
    }
  }
}
